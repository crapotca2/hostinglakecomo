MONGODB_URI=mongodb+srv://...
MONGODB_DB=air_bibby

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Admin credentials.
# Generate hash with: node scripts/hash-password.mjs "<your password>"
# Put the resulting bcrypt hash here. ADMIN_PASSWORD (plain) is only honored in dev.
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=actopark@gmail.com
ADMIN_NAME=Andrei
# ADMIN_PASSWORD=your-password   # dev-only plain fallback, do not set in production

NEXT_PUBLIC_SITE_URL=https://hostcomo.com

# Optional: gate /api/seed in non-prod environments
ALLOW_SEED=false

# ── Beds24 integration ─────────────────────────────────────────────────
# Long-life token (preferito, semplice): Settings → Account Access → API V2
# https://beds24.com/control3.php?pagetype=settings_account_access
BEDS24_LONG_LIFE_TOKEN=

# Refresh token (alternativa OAuth — usato solo se LONG_LIFE non c'è)
BEDS24_REFRESH_TOKEN=

# Override solo per testing endpoint custom. Default: https://api.beds24.com/v2
BEDS24_API_URL=

# Forza modalità mock anche se i token sono settati (dev only)
USE_BEDS24_MOCK=false

# Webhook HMAC secret. Stessa stringa configurata nella UI Beds24 webhook.
BEDS24_WEBHOOK_SECRET=

# Cron auth (Vercel inietta automaticamente Bearer $CRON_SECRET)
CRON_SECRET=

# Token per chiamare l'endpoint admin /api/admin/beds24/bootstrap via curl
ADMIN_BOOTSTRAP_TOKEN=
